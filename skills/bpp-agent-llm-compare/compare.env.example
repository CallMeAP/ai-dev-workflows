# bpp-agent-llm-compare: copy next to your selftest.env (e.g. $DEMO_HOME/compare.env), fill it, export COMPARE_ENV=<that file>.
# The scripts load SELFTEST_ENV (the main skill's env: demo stack URLs, demo DB, login) first, then this file.
# No secret goes into this file: an API key lives in its own mode-600 file named by CHALLENGER_KEY_FILE.

# Luna: the default arm, the stage's Codex provider (model Llm:Codex:Model, gpt-6-luna on development)
export LUNA_PROVIDER=openai-codex

# The challenger. KIND local = llama.cpp / Ollama / vLLM on this machine or on an LLM Mac over the 'mac' WireGuard VPN
# (10.13.13.0/24); KIND hosted = a vendor API (synthetic data only).
#   local llama.cpp:  CHALLENGER_PROVIDER=llamacpp (the agent's own Llm:LlamaCpp section; llama-server must run with --jinja)
#   Ollama / vLLM / hosted: any other id -> Llm:OpenAiCompatible:<id>
export CHALLENGER_KIND=local
export CHALLENGER_PROVIDER=llamacpp
export CHALLENGER_ENDPOINT=http://10.13.13.9:8000/v1         # default: Qwen on the LLM Mac (needs the 'mac' VPN); this machine: http://127.0.0.1:8000/v1
export CHALLENGER_MODEL=unsloth/Qwen3.5-35B-A3B-GGUF:Q8_0     # what 10.13.13.9 serves (GET /v1/models); local CPU default: unsloth/Qwen3.5-4B-GGUF:Q8_0
export CHALLENGER_CONTEXT_TOKENS=62016                        # per-slot window = /props n_ctx / total_slots (10.13.13.9: 248064 / 4); hosted: the model's window
export CHALLENGER_MAX_TOOLS=                                  # Llm:OpenAiCompatible:<id>:MaxToolsPerRequest (Groq: 128), empty = none

# Hosted only
export CHALLENGER_KEY_FILE=                                   # mode-600 file with the API key; Anthropic: a Console API key ONLY
export SYNTHETIC_DATA_CONFIRMED=no                            # yes only after the developer confirmed DEMO_DB holds synthetic data only
export PRICE_IN_PER_M_USD=0                                   # list price per 1M input tokens of CHALLENGER_MODEL
export PRICE_OUT_PER_M_USD=0                                  # list price per 1M output tokens
export BUDGET_USD=5                                           # stop before the next case once this run's estimate reaches it

# Stop rules (Codex 95/95 comes from selftest.env: MAX_PRIMARY_PCT / MAX_SECONDARY_PCT)
export MAX_ITER=5                                             # tuning iterations per run
export SPLIT_SEED=bpp-agent-llm-compare-v1                    # keep it: a new seed reshuffles tune/held-back and leaks held-back cases
