# bpp-agent-llm-selftest: one env file per demo stack. Copy to $DEMO_HOME/selftest.env (outside every repo) and point
# SELFTEST_ENV at it. No secrets in here: the DB password and the login password are read from files at run time.
# Values below match the live-t3 demo stack (ports 62xx, Cockpit 4210). bpp-agent docs/local-demo-stack.md uses 4201 for the Cockpit.

export BPP_ROOT=/home/alex/Entwicklung/bpp
export DEMO_HOME="$HOME/.local/state/bpp-demo-t3"          # start.sh, stop.sh, rabbit-start.sh, pids.txt, pg-password.local

# Database: the demo copy on this machine only. lib.sh allows only PGHOST=localhost and DEMO_DB=bpp_agent_demo_* (not _train).
export DEMO_DB=bpp_agent_demo_t3
export PGHOST=localhost PGPORT=5432 PG_USER=admin
export PG_PASSWORD_FILE="$DEMO_HOME/pg-password.local"     # mode 600, one line, never printed

# Demo stack URLs. lib.sh allows only http://localhost / 127.0.0.1 and refuses 52xx (the normal stack another session may test on).
export AUTH_URL=http://localhost:6240
export FILE_URL=http://localhost:6242
export BACKEND_URL=http://localhost:6244
export CONNECTOR_URL=http://localhost:6251
export AGENT_URL=http://localhost:6253
export COCKPIT_URL=http://localhost:4210
export RABBIT_MGMT_URL=http://localhost:7273

# Worktrees the stack runs (for the SHA line and the Cockpit client regen) and the agent log (catalog check)
export AGENT_WORKTREE="$BPP_ROOT/bpp-agent.worktrees/live-t3"
export BACKEND_WORKTREE="$BPP_ROOT/bpp-backend.worktrees/live-t3"
export SHARED_WORKTREE="$BPP_ROOT/bpp-shared.worktrees/live-t3"
export COCKPIT_WORKTREE="$BPP_ROOT/brokernet-cockpit-ui.worktrees/live-ui"
export AGENT_LOG="$DEMO_HOME/logs/agent.log"

# The developer GoUser of the demo DB (can_use_ki_assistent + is_developer, Codex linked). Set it in YOUR copy only;
# never commit it. The password defaults to the fleet dev default; put another one into a 600 file and name it here.
export OWNER_GO_USER_ID=
export SELFTEST_LOGIN_EMAIL=
export SELFTEST_LOGIN_PASSWORD_FILE=
# Repo fixtures name their group ("session": {"group": "G1"}): the id of "Team Eval Nord" from seeds/custscope-gen.py
export SELFTEST_GROUP_G1=c5c50000-0000-4000-8000-0000000061a1

# Codex stop (user rule since 2026-11-16): pause every live LLM call at 95 % of the 5 h window or 95 % of the week
export MAX_PRIMARY_PCT=95 MAX_SECONDARY_PCT=95

# UI suite: a Chromium binary and a puppeteer-core install (any node_modules that has it); latency needs 'ws'
export CHROME=/snap/bin/chromium
export PUPPETEER_CORE=                                      # e.g. <some project>/node_modules/puppeteer-core
export NODE_MODULES_FROM="$COCKPIT_WORKTREE"                # a package dir whose node_modules has 'ws'
